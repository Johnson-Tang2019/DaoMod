{
	"chapter.a000000000000001.title": "道途劫灭：修行之路"
	"quest.a100000000000001.title": "翻开道途指南"
	"quest.a100000000000001.quest_desc": ["取得《道途指南》，了解境界、炁、丹毒、因果与位面系统。"]
	"quest.a200000000000001.title": "聚灵打坐"
	"quest.a200000000000001.quest_desc": ["取得蒲团和任意基础灵植。", "把灵植、灵矿布置在蒲团附近，可将单次修炼进度从 +1 提升到最高 +6。"]
	"quest.a300000000000001.title": "选择宗门"
	"quest.a300000000000001.quest_desc": ["使用 /dao join <1-4> 加入天枢剑宗、造化仙宗、大雷音寺或罗刹魔教。", "入宗只能选择一次；加入成功后，宗门进度会自动记录。"]
	"quest.a400000000000001.title": "以炁御剑"
	"quest.a400000000000001.quest_desc": ["取得玄天灵剑。金丹境可完整催动剑气，筑基后可开始御剑飞行。"]
	"quest.a500000000000001.title": "踏入灵虚界"
	"quest.a500000000000001.quest_desc": ["使用隔世之门进入灵虚界，寻找七域资源、宗门据点与传奇地标。"]
	"quest.a600000000000001.title": "剑道纪元"
	"quest.a600000000000001.quest_desc": ["达到化神并参与击败一位剑道传奇。多人参战时，每名有效参与者都会记录进度。"]
	"quest.a700000000000001.title": "造化纪元"
	"quest.a700000000000001.quest_desc": ["完成剑道试炼后，参与击败一位造化宗师。"]
	"quest.a800000000000001.title": "帝落长夜"
	"quest.a800000000000001.quest_desc": ["进入帝落渊，并依次完成佛魔与禁忌纪元。准备抗火、抗凋零与解控手段。"]
	"quest.a900000000000001.title": "永恒仙域"
	"quest.a900000000000001.quest_desc": ["进入浮岛仙域，建立桥头堡并寻找造化工坊、秘库与荒古神碑。"]
	"quest.aa00000000000001.title": "荒古终局"
	"quest.aa00000000000001.quest_desc": ["参与击败一位荒古强者，完成五组纪元试炼。首次完成可获得个人终局奖励。"]
	"chapter.c000000000000001.title": "修炼基础详解"
	"quest.c100000000000001.title": "阅读指南"
	"quest.c100000000000001.quest_desc": ["《道途指南》是游戏内完整手册。先阅读境界、炁、丹毒和因果页面，再开始修炼。"]
	"quest.c200000000000001.title": "制作蒲团"
	"quest.c200000000000001.quest_desc": ["放置蒲团并右键坐下。每轮打坐都会计算附近灵气，获得突破进度。"]
	"quest.c300000000000001.title": "布置灵植"
	"quest.c300000000000001.quest_desc": ["灵植提供温和灵气。将数株不同灵植种在蒲团周围，形成稳定修炼区。"]
	"quest.c400000000000001.title": "引入灵矿"
	"quest.c400000000000001.quest_desc": ["灵矿的灵气强于灵植。把矿石保留在蒲团附近，而不是全部挖走。"]
	"quest.c500000000000001.title": "完成一次突破"
	"quest.c500000000000001.quest_desc": ["进度达到 100 自动突破，溢出会保留。小突破恢复部分生命，跨大境界恢复全部生命与炁。", "先通过修炼积累经验，并准备八瓶附魔之瓶作为后续探索补给。"]
	"quest.c600000000000001.title": "问灵寻脉"
	"quest.c600000000000001.quest_desc": ["手持问灵短剑右键，可感应十米内最近的灵植或灵矿，并显示方向、距离和强度。"]
	"quest.c700000000000001.title": "丹药与丹毒"
	"quest.c700000000000001.quest_desc": ["丹药适合冲刺突破，但连续服用会累积丹毒。丹毒反噬期间无法继续靠丹药和打坐推进。", "取得丹药即可完成目标；服用前先观察当前丹毒，避免在反噬期浪费药力。"]
	"quest.c800000000000001.title": "玄天灵剑"
	"quest.c800000000000001.quest_desc": ["右键蓄力、松开释放剑气。境界低于武器品阶时，剑气与近战伤害都会受到限制。"]
	"quest.c900000000000001.title": "御剑飞行"
	"quest.c900000000000001.quest_desc": ["筑基后手持可用灵剑，离地右键进入御剑。炁和武器品阶决定能否稳定飞行。", "准备八枚烟花火箭作为远行备用推进与紧急脱离手段。"]
	"quest.ca00000000000001.title": "死亡与因果"
	"quest.ca00000000000001.quest_desc": ["死亡会退小阶段，阶段为零时会跌落大境界，并清空炁。杀戮产生永久因果，因果 20 以上突破还会引发心魔劫。"]
	"quest.cb00000000000001.title": "准备远行"
	"quest.cb00000000000001.quest_desc": ["准备同境武器、恢复品、备用方块和返程手段。库存属性面板可核对生命、攻击、护甲、移速和突破进度。"]
	"chapter.e000000000000001.title": "四宗道统详解"
	"quest.e100000000000001.title": "了解四大道统"
	"quest.e100000000000001.quest_desc": ["入宗只能选择一次。先阅读四个分支的加成、守卫和据点，再决定路线。"]
	"quest.e200000000000001.title": "太上天枢剑宗"
	"quest.e200000000000001.quest_desc": ["攻击 +3、移动速度 +5%。剑侍巡游山地，攻击附带缓速；剑亭和剑冢适合剑修搜集剑意草与庚金。"]
	"quest.e300000000000001.title": "造化仙宗"
	"quest.e300000000000001.quest_desc": ["幸运 +3、回炁效率更高。器徒擅长自愈；造化工坊和秘库产出炼器、丹道资源。"]
	"quest.e400000000000001.title": "大雷音寺"
	"quest.e400000000000001.quest_desc": ["护甲 +5、击退抗性 +20%。武僧会施加虚弱；高原禅台适合稳健近战和体修。"]
	"quest.e500000000000001.title": "罗刹魔教"
	"quest.e500000000000001.quest_desc": ["攻击 +5、移动速度 +8%。魔徒主动攻击外人并施加凋零；路线爆发高但风险最大。"]
	"quest.e600000000000001.title": "正式入宗"
	"quest.e600000000000001.quest_desc": ["使用 /dao join 1、2、3 或 4 加入所选宗门。管理员可用 /dao sect set 调整错误选择。"]
	"quest.e700000000000001.title": "宗门仇恨"
	"quest.e700000000000001.quest_desc": ["同宗守卫不会主动攻击你，不同宗守卫彼此敌对。罗刹魔徒会攻击所有外宗玩家。"]
	"quest.e800000000000001.title": "寻找宗门据点"
	"quest.e800000000000001.quest_desc": ["剑亭在山地，造化坊在平原林地，禅台在高原，罗刹祭坛靠近恶地和洞穴。", "从据点或西极金戈取得一块庚金神矿，证明你已掌握宗门资源路线。"]
	"quest.e900000000000001.title": "取得宗门资源"
	"quest.e900000000000001.quest_desc": ["击败敌宗守卫或搜索据点宝箱，取得灵植、灵矿或法器。注意守卫会呼叫同伴。"]
	"chapter.1100000000000001.title": "四界探索详解"
	"quest.1200000000000001.title": "隔世之门"
	"quest.1200000000000001.quest_desc": ["隔世之门按主世界 → 灵虚界 → 帝落渊 → 永恒仙域 → 主世界循环传送，并保留水平坐标。"]
	"quest.1400000000000001.title": "进入灵虚界"
	"quest.1400000000000001.quest_desc": ["灵虚界是中期主世界。先建立传送落点据点，再探索七域，不要立刻远离返程位置。"]
	"quest.1600000000000001.title": "七域资源"
	"quest.1600000000000001.quest_desc": ["北极找寒铁，南疆找离火赤金，西极找庚金神矿，中央找导灵玉，虚空天外找虚空晶。", "每种资源收集三份；任务会分别追踪五条采集目标，全部达成后自动完成。"]
	"quest.1800000000000001.title": "传奇地标"
	"quest.1800000000000001.quest_desc": ["寻找剑冢、造化秘库、幽冥古祠、虚空观星台或荒古神碑。核心附近打坐有洞天福地加成。"]
	"quest.1a00000000000001.title": "进入帝落渊"
	"quest.1a00000000000001.quest_desc": ["帝落渊固定永夜，床不可用而重生锚可用。进入前准备火焰抗性、解控和缓降。"]
	"quest.1c00000000000001.title": "长夜生存"
	"quest.1c00000000000001.quest_desc": ["玄武岩、魂沙和菌林间落差巨大。先照明、封闭退路，再搜索虚空晶和高阶战帖材料。"]
	"quest.1e00000000000001.title": "建立深渊据点"
	"quest.1e00000000000001.quest_desc": ["放置重生锚、储物和防火区域。不要在未设置重生点前携带全部高阶材料深入。"]
	"quest.2100000000000001.title": "进入永恒仙域"
	"quest.2100000000000001.quest_desc": ["仙域由末地式空岛组成。传送优先寻找安全岛面，原坐标无岛时会落到中央仙岛。"]
	"quest.2300000000000001.title": "空岛桥头堡"
	"quest.2300000000000001.quest_desc": ["先建防坠围栏和储物点，再按造化工坊、观星台/秘库、荒古神碑的三级路线探索。"]
	"quest.2500000000000001.title": "虚空逃生"
	"quest.2500000000000001.quest_desc": ["跌出仙域会返回主世界同坐标上空并获得 12 秒缓降。仍应携带末影珍珠和方块，避免物资散失。"]
	"quest.2700000000000001.title": "完成四界巡游"
	"quest.2700000000000001.quest_desc": ["再次使用隔世之门返回主世界，整理三界资源并准备最终荒古战帖。"]
	"task.d100000000000001.title": "取得《道途指南》"
	"task.d200000000000001.title": "制作修炼蒲团"
	"task.d300000000000001.title": "采集灵芝"
	"task.d400000000000001.title": "采集灵石矿"
	"task.d500000000000001.title": "积攒八瓶附魔之瓶"
	"task.d600000000000001.title": "制作问灵短剑"
	"task.d700000000000001.title": "取得一枚丹药"
	"task.d800000000000001.title": "取得玄天灵剑"
	"task.d900000000000001.title": "准备八枚烟花火箭"
	"task.da00000000000001.title": "击败三只僵尸"
	"task.db00000000000001.title": "准备八个金苹果"
	"task.f100000000000001.title": "携带指南查阅四宗资料"
	"task.f200000000000001.title": "采集三株剑意草"
	"task.f300000000000001.title": "采集三枚醉仙桃"
	"task.f400000000000001.title": "采集三株枯荣参"
	"task.f500000000000001.title": "采集三株千机引"
	"task.f600000000000001.title": "正式加入任意宗门"
	"task.f700000000000001.title": "击败一名罗刹魔徒"
	"task.f800000000000001.title": "取得一块庚金神矿"
	"task.f900000000000001.title": "取得四块导灵玉"
	"task.1300000000000001.title": "取得隔世之门"
	"task.1500000000000001.title": "抵达灵虚界"
	"task.1700000000000001.title": "取得三块寒铁矿"
	"task.1710000000000001.title": "取得三块离火赤金"
	"task.1720000000000001.title": "取得三块庚金神矿"
	"task.1730000000000001.title": "取得三块导灵玉"
	"task.1740000000000001.title": "取得三块虚空晶"
	"task.1900000000000001.title": "取得荒古血脉战帖"
	"task.1b00000000000001.title": "抵达帝落渊"
	"task.1d00000000000001.title": "击败五只烈焰人"
	"task.1f00000000000001.title": "准备一座重生锚"
	"task.2200000000000001.title": "抵达永恒仙域"
	"task.2400000000000001.title": "准备一组末地石"
	"task.2600000000000001.title": "准备十六颗末影珍珠"
	"task.2800000000000001.title": "返回主世界"
}
